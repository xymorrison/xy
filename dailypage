<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Space+Grotesk:wght@400;500;600;700&family=Libre+Caslon+Text:ital@1&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #f2f1ec; --panel: #e7e4dc; --ink: #262b30; --ink-soft: #7c8085;
    --accent: #3b4a56; --accent-soft: #dbe2e6; --espresso: #4a3222; --espresso-soft: #e6dbcd;
    --line: rgba(38,43,48,0.15);
  }
  *{ box-sizing:border-box; }
  .term-app{
    background: var(--bg); color: var(--ink);
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    padding: 30px 32px 46px; max-width: 1260px; margin: 0 auto; border-radius: 10px;
  }
  .masthead{ display:flex; justify-content:space-between; align-items:flex-end; padding-bottom: 20px; border-bottom: 1px solid var(--line); margin-bottom: 30px; }
  .kicker{ font-size: 11px; letter-spacing: 1.8px; text-transform: uppercase; color: var(--accent); font-weight: 700; margin-bottom: 8px; }
  .title-mark{ position:relative; display:inline-block; height:50px; margin-bottom: 4px; }
  .title-mark .aw{ position:absolute; top:0; left:2px; font-family:'Libre Caslon Text',Georgia,serif; font-style:italic; font-size:15px; color:var(--accent); }
  .title-mark .semester{ position:absolute; top:4px; left:34px; font-family:'Pinyon Script',cursive; font-size:48px; color:var(--espresso); line-height:1; white-space:nowrap; }
  .masthead .byline{ font-size: 11px; letter-spacing: 0.8px; text-transform: uppercase; color: var(--ink-soft); }
  .week-nav{ display:flex; gap: 7px; }
  .day-tab{ width: 48px; text-align:center; padding: 9px 2px 10px; cursor:pointer; border-radius: 8px; background: var(--panel); }
  .day-tab .d{ font-size: 9.5px; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.4px; }
  .day-tab .n{ font-family:'Fraunces',serif; font-weight:600; font-size: 15px; margin-top: 2px; color: var(--ink); }
  .day-tab.today{ box-shadow: inset 0 0 0 1.5px var(--accent); }
  .day-tab.selected{ background: var(--ink); }
  .day-tab.selected .d, .day-tab.selected .n{ color: var(--bg); }
  .day-tab .fill{ margin-top:6px; height:2.5px; border-radius:2px; background: rgba(38,43,48,0.13); }
  .day-tab .fill i{ display:block; height:100%; border-radius:2px; background: var(--accent); }
  .day-tab.selected .fill{ background: rgba(242,241,236,0.3); }

  .main-grid{ display:grid; grid-template-columns: 1fr 1.5fr 1fr; gap: 30px; align-items:start; }
  @media (max-width: 900px){ .main-grid{ grid-template-columns: 1fr; } .side-col, #dailyCol, #digestCol{ margin-top:0 !important; } }

  .side-col{ display:flex; flex-direction:column; gap: 24px; margin-top: 52px; }
  #dailyCol{ margin-top: 0; }
  #digestCol{ margin-top: 26px; }

  .col{ background: var(--panel); border-radius: 14px; overflow:hidden; }
  .col img{ width:100%; aspect-ratio: 5/4; object-fit:cover; display:block; }
  .streak-card img, .playlist-card img, .read-card img{ aspect-ratio: 2.4/1; }
  .col-head{ padding: 18px 22px 4px; }
  .section-label{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size: 12px; letter-spacing: 1.4px; text-transform: uppercase; color: var(--ink-soft); margin: 0; }
  .col-body{ padding: 6px 22px 20px; }

  .track-block{ border-top: 1px solid var(--line); padding: 16px 0 6px; }
  .track-block:first-child{ border-top: none; }
  .track-block.boundary-block{ border-top: 1px dashed var(--line); margin-top: 6px; }
  .track-head{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom: 9px; }
  .track-head .name{ display:flex; align-items:baseline; gap:8px; }
  .track-head h2{ font-family:'Space Grotesk',sans-serif; font-weight:700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.6px; margin:0; }
  .track-head .tag{ font-size: 9.5px; color: var(--accent); font-weight:700; text-transform: uppercase; letter-spacing: 0.5px; }
  .track-head .count{ font-size: 11.5px; color: var(--ink-soft); font-weight:600; }

  .item{ display:flex; align-items:flex-start; gap:11px; padding: 6.5px 0; cursor:pointer; font-size: 13.5px; }
  .box{ flex-shrink:0; width:15px; height:15px; margin-top:2px; border: 1.5px solid var(--ink-soft); border-radius: 4px; position:relative; }
  .item.done .box{ background: var(--espresso); border-color: var(--espresso); }
  .item.done .box::after{ content:''; position:absolute; left:3.5px; top:1px; width:5px; height:9px; border: solid var(--bg); border-width: 0 1.6px 1.6px 0; transform: rotate(40deg); }
  .item.done span{ text-decoration: line-through; opacity:0.5; }

  .streak-card .streak-body{ padding: 20px 18px; text-align:center; }
  .streak-card .num{ font-family:'Fraunces',serif; font-weight:700; font-size: 40px; color: var(--espresso); line-height:1; }
  .streak-card .lbl{ font-size: 10.5px; color: var(--ink-soft); letter-spacing: 1px; text-transform: uppercase; margin-top: 4px; }

  .playlist-card .playlist-body{ padding: 16px 18px; text-align:center; }
  .playlist-card .glyph{ font-size: 22px; color: var(--accent); margin-bottom: 4px; }
  .playlist-card .pl-label{ font-size: 10.5px; color: var(--ink-soft); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; }
  .playlist-card .pl-link{ font-family:'Space Grotesk',sans-serif; font-weight:600; font-size: 13px; color: var(--espresso); text-decoration: none; border-bottom: 1px solid var(--espresso); padding-bottom: 1px; }

  .read-card{ display:block; text-decoration:none; color: inherit; }
  .read-card .read-body{ padding: 16px 18px; }
  .read-card .rd-label{ font-size: 10px; color: var(--ink-soft); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 6px; }
  .read-card .rd-title{ font-family:'Fraunces',serif; font-weight:600; font-size: 15px; color: var(--espresso); line-height:1.3; margin-bottom: 3px; }
  .read-card .rd-source{ font-size: 11.5px; color: var(--ink-soft); }

  .checkpoint-line{ font-family:'Libre Caslon Text',Georgia,serif; font-style: italic; font-size: 14px; color: var(--ink-soft); padding: 0 18px 14px; }

  .digest-field{ margin-bottom: 17px; }
  .digest-field:last-child{ margin-bottom:0; }
  .digest-field label{ display:block; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--ink); margin-bottom: 7px; }
  .digest-field textarea{
    width:100%; font-family: 'Space Grotesk', sans-serif; font-size: 13px; color: var(--ink);
    background: var(--bg); border: 1px solid var(--line); border-radius: 7px;
    padding: 9px 11px; resize: vertical; min-height: 42px; line-height:1.5;
  }
  .digest-field textarea::placeholder{ color: rgba(38,43,48,0.4); }
  .digest-field textarea:focus{ outline:none; border-color: var(--accent); }
  .saved-note{ font-size: 10.5px; color: var(--accent); text-align:right; margin-top: 4px; height: 14px; font-weight:600; }

  .elsewhere{ margin: 34px 0 6px; padding-top: 22px; border-top: 1px solid var(--line); }
  .elsewhere-row{ display:flex; gap: 16px; flex-wrap: wrap; }
  .elsewhere-item{
    flex: 1 1 260px; display:flex; gap: 12px; align-items:center;
    background: var(--panel); border-radius: 10px; padding: 12px 14px; text-decoration:none; color: var(--ink);
  }
  .elsewhere-item .glyph{
    width: 38px; height: 38px; border-radius: 8px; background: var(--accent-soft);
    display:flex; align-items:center; justify-content:center; flex-shrink:0; color: var(--espresso); font-size: 15px;
  }
  .elsewhere-item .exbody{ min-width:0; }
  .elsewhere-item .extag{ font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--accent); font-weight:700; margin-bottom: 2px; }
  .elsewhere-item .exname{ font-size: 13px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .elsewhere-item .exsub{ font-size: 11px; color: var(--ink-soft); }
</style>

<div class="term-app" id="termApp">
  <div class="masthead">
    <div>
      <div class="kicker">The Autumn Term</div>
      <div class="title-mark"><span class="aw">A/W</span><span class="semester">Semester</span></div>
      <div class="byline" id="monthLabel">September — Settling In</div>
