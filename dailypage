</div>

<script>
(function(){

  const MONTH_THEMES = {
    8: { label: "September — Settling In", note: "Rhythm exists. You don't need results yet — you need the habit to have survived four weeks." },
    9: { label: "October — Building Volume", note: "At least one new lead from outreach, plus a month of consistency behind you." },
    10:{ label: "November — Taking Stock", note: "You could explain, in a sentence each, what's working and what you'd change." },
    11:{ label: "December — Closing the Term", note: "What actually changed since 15 September, in your own words." }
  };

  const MORNING_VARIANTS = [
    ["Tea", "A walk", "Jot down the day's to-dos"],
    ["Stretch", "Tea", "A little reading", "Jot down the day's to-dos"],
    ["Stretch", "A walk", "Coffee", "Jot down the day's to-dos"]
  ];

  const FALLBACK_IMG = "";
  const READS = [
    { t:"AI Use Cases for Legal Work", s:"Entertainment Meets Law", u:"https://entertainmentmeetslaw.substack.com/p/ai-use-cases-for-legal-work-part-ff4", img:null },
    { t:"Adult Hobbies Worth Trying", s:"Ayushi Thakkar", u:"https://ayushithakkar.substack.com/p/adult-hobbies-worth-trying", img:"https://substackcdn.com/image/fetch/$s_!jwxV!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F9e1da085-2054-488e-95af-b6df0eb41efb_640x427.jpeg" },
    { t:"Intellectual Property Is a Feminist Issue", s:"Zawn", u:"https://zawn.substack.com/p/intellectual-property-is-a-feminist", img:"https://substackcdn.com/image/fetch/$s_!LUiY!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7d638316-0592-45db-b8b6-40779627bbb7_5184x3456.jpeg" },
    { t:"Hell Was Invented to Terrify", s:"Chukwuchidinma", u:"https://chukwuchidinma.substack.com/p/hell-was-invented-to-terrify-the", img:"https://substackcdn.com/image/fetch/$s_!fEa2!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5db6baca-ce9f-4965-862f-897ddb333076_1024x683.jpeg" },
    { t:"How to Start Self-Studying", s:"Rana Habib", u:"https://ranahabib.substack.com/p/how-to-start-self-studying", img:"https://substackcdn.com/image/fetch/$s_!L-d2!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F3f2084af-7b1d-4f25-88bb-ebdcd3fbb0d2_1290x1015.jpeg" },
    { t:"Morgan Freeman & Memento", s:"The Industry", u:"https://theindustry.co/p/morgan-freeman-memento", img:"https://substackcdn.com/image/fetch/$s_!rd8r!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F0ac7a2dd-6de3-47d8-b8e3-3e91aa4a6d20_1000x563.jpeg" },
    { t:"What's a Soft Life to a Black Woman", s:"Blackstack", u:"https://blackstack.substack.com/p/whats-a-soft-life-to-a-black-woman", img:"https://substackcdn.com/image/fetch/$s_!e8s0!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F9d735459-95f9-49db-a8e0-d17b4ab3e646_1078x1335.heic" },
    { t:"The Financialization of Fandom", s:"Entertainment Meets Law", u:"https://entertainmentmeetslaw.substack.com/p/the-financialization-of-fandom", img:"https://substackcdn.com/image/fetch/$s_!L12-!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F6f2cb4a8-986a-48ee-b7e0-d67dfed7c215_800x1200.png" },
    { t:"How to Crave Doing Hard Things", s:"Celine's Notes", u:"https://celinesnotes.substack.com/p/how-to-crave-doing-hard-things", img:"https://substackcdn.com/image/fetch/$s_!st30!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F4a6ef7e1-b1fa-42c7-bbf6-c089218cf051_1920x1080.png" },
    { t:"The Church of Intellectual Property", s:"Innomen", u:"https://innomen.substack.com/p/the-church-of-intellectual-property", img:null },
    { t:"How to Write About Film", s:"cchelmetgirl", u:"https://cchelmetgirl.substack.com/p/how-to-write-about-film", img:"https://substackcdn.com/image/fetch/$s_!xVnE!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb5233ba9-06ae-4ceb-b770-d0a676cca106_800x366.jpeg" },
    { t:"What Does It Mean to Have a Room", s:"The Open Letters", u:"https://theopenletters.substack.com/p/what-does-it-mean-to-have-a-room", img:"https://substackcdn.com/image/fetch/$s_!l5my!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F675bf5a5-0801-4fc3-ac80-91974210c030_720x422.jpeg" },
    { t:"Influencer Biz: Legal Considerations", s:"Entertainment Meets Law", u:"https://entertainmentmeetslaw.substack.com/p/influencer-biz-legal-considerations", img:"https://substackcdn.com/image/fetch/$s_!xivZ!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fbf9a16cf-cbef-4181-a127-ae9c9da2e5ed_570x410.jpeg" },
    { t:"The Death of the Public Intellectual", s:"The Digital Meadow", u:"https://thedigitalmeadow.substack.com/p/the-death-of-the-public-intellectual", img:"https://substackcdn.com/image/fetch/$s_!4Bd-!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa58b735b-7657-4326-ad6a-16a947ffa483_2560x1460.jpeg" },
    { t:"Can AI Really Write?", s:"The New York Times", u:"https://www.nytimes.com/2026/08/04/opinion/artificial-intelligence-ai-writing.html", img:null }
  ];
  const PLAYLIST_URL = "https://open.spotify.com/playlist/37i9dQZF1FbI1zqmWLgS2K?si=e427bd41769e4d5a";
  const EPOCH = new Date(2026,0,1);
  function todaysRead(d){
    const idx = Math.floor((d - EPOCH) / 86400000) % READS.length;
    return READS[(idx + READS.length) % READS.length];
  }

  const LABELS = { ritual: 'First 20 Minutes', sqe: 'SQE Study', career: 'Career & Income', health: 'Health & Appearance', writing: 'Writing' };
  const TAGS = { ritual: '', sqe: 'Anchor', career: 'Daily', health: 'Daily', writing: 'Rotating' };
  const TRACK_ORDER = ['ritual','sqe','career','health','writing'];

  function ritualItems(dow){ return MORNING_VARIANTS[dow % 3]; }
  function sqeItems(){ return ["Study block", "Flashcard review", "MCQ practice"]; }
  function careerItems(){ return ["Send / progress an application", "Current-awareness reading", "One networking touchpoint", "Blog or CV work"]; }
  function healthItems(){ return ["Skincare, AM & PM", "Hit your sleep window", "Water target", "Cook / no-decision shelf — no takeout", "One feel-good habit"]; }
  function writingItems(){ return ["Writing session — move it if today's full, don't skip it"]; }
  function mondayItems(){ return ["Build out the real debt-plan numbers", "Call StepChange or National Debtline"]; }
  function sundayItems(){ return ["Weekly money check (5 minutes)", "Glance at the week ahead"]; }

  function itemsForTrack(track, dow){
    if(track==='ritual') return ritualItems(dow);
    return { sqe: sqeItems(), career: careerItems(), health: healthItems(), writing: writingItems() }[track];
  }

  function fmtKey(d){ return d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + String(d.getDate()).padStart(2,"0"); }
  function mondayOf(d){ const day=(d.getDay()+6)%7; const m=new Date(d); m.setDate(d.getDate()-day); return m; }

  const today = new Date(); today.setHours(0,0,0,0);
  const weekStart = mondayOf(today);
  const weekDates = [...Array(7)].map((_,i)=>{ const d=new Date(weekStart); d.setDate(weekStart.getDate()+i); return d; });

  let selected = new Date(today);
  let cache = {};
  let digestCache = null;

  async function loadDay(key){
    if(cache[key]) return cache[key];
    try{
      const res = await window.storage.get('day:'+key, false);
      cache[key] = res && res.value ? JSON.parse(res.value) : {};
    }catch(e){ cache[key] = {}; }
    return cache[key];
  }
  async function saveDay(key){
    try{ await window.storage.set('day:'+key, JSON.stringify(cache[key]||{}), false); }
    catch(e){ console.error('storage set failed', e); }
  }
  async function loadDigest(){
    const key = fmtKey(weekStart);
    if(digestCache) return digestCache;
    try{
      const res = await window.storage.get('digest:'+key, false);
      digestCache = res && res.value ? JSON.parse(res.value) : {};
    }catch(e){ digestCache = {}; }
    return digestCache;
  }
  async function saveDigest(){
    const key = fmtKey(weekStart);
    try{ await window.storage.set('digest:'+key, JSON.stringify(digestCache||{}), false); }
    catch(e){ console.error('digest save failed', e); }
  }

  function dayRatio(state, dow){
    let total=0, done=0;
    TRACK_ORDER.forEach(track=>{
      itemsForTrack(track, dow).forEach((_,i)=>{ total++; if(state[track+'-'+i]) done++; });
    });
    if(dow===0){ mondayItems().forEach((_,i)=>{ total++; if(state['mon-'+i]) done++; }); }
    if(dow===6){ sundayItems().forEach((_,i)=>{ total++; if(state['sun-'+i]) done++; }); }
    total++; if(state['boundary']) done++;
    return total ? done/total : 0;
  }
  function isAnchorComplete(state){ return sqeItems().every((_,i)=> state['sqe-'+i]); }

  async function computeStreak(){
    let streak=0; let cursor=new Date(today);
    while(true){
      const key = fmtKey(cursor); const state = await loadDay(key);
      if(isAnchorComplete(state)){ streak++; cursor.setDate(cursor.getDate()-1); }
      else break;
    }
    return streak;
  }

  async function renderWeekStrip(){
    const strip = document.getElementById('weekStrip'); strip.innerHTML='';
    for(const d of weekDates){
      const key = fmtKey(d); const state = await loadDay(key);
      const dow = (d.getDay()+6)%7; const ratio = dayRatio(state, dow);
      const tab = document.createElement('div');
      tab.className = 'day-tab' + (fmtKey(d)===fmtKey(today)?' today':'') + (fmtKey(d)===fmtKey(selected)?' selected':'');
      tab.innerHTML = `<div class="d">${d.toLocaleDateString('en-GB',{weekday:'short'}).slice(0,2)}</div>
        <div class="n">${d.getDate()}</div>
        <div class="fill"><i style="width:${Math.round(ratio*100)}%"></i></div>`;
      tab.addEventListener('click', ()=>{ selected = new Date(d); renderAll(); });
      strip.appendChild(tab);
    }
  }

  function renderCheckpoint(){
    const theme = MONTH_THEMES[selected.getMonth()] || MONTH_THEMES[8];
    document.getElementById('monthLabel').textContent = theme.label;
    document.getElementById('heroCaption').textContent = theme.note;
  }

  function buildTrackBlock(track, label, tag, items, state, key, extraClass){
    const done = items.filter((_,i)=> state[track+'-'+i]).length;
    const block = document.createElement('div'); block.className = 'track-block' + (extraClass?(' '+extraClass):'');
    const tagHtml = tag ? `<span class="tag">${tag}</span>` : '';
    block.innerHTML = `<div class="track-head"><span class="name"><h2>${label}</h2>${tagHtml}</span><div class="count">${done}/${items.length}</div></div>`;
    items.forEach((label2,i)=>{
      const row = document.createElement('div'); const idKey = track+'-'+i;
      row.className = 'item' + (state[idKey] ? ' done' : '');
      row.innerHTML = `<div class="box"></div><span>${label2}</span>`;
      row.addEventListener('click', async ()=>{
        state[idKey] = !state[idKey]; cache[key]=state; await saveDay(key); renderAll();
      });
      block.appendChild(row);
    });
    return block;
  }

  async function renderEntries(){
    const key = fmtKey(selected); const state = await loadDay(key);
    const dow = (selected.getDay()+6)%7;
    const box = document.getElementById('entriesBox'); box.innerHTML='';

    TRACK_ORDER.forEach(track=>{
      box.appendChild(buildTrackBlock(track, LABELS[track], TAGS[track], itemsForTrack(track, dow), state, key));
    });

    if(dow===0){ box.appendChild(buildTrackBlock('mon', 'Debt Sprint', 'Monday Only', mondayItems(), state, key)); }
    if(dow===6){ box.appendChild(buildTrackBlock('sun', 'Week Close', 'Sunday Only', sundayItems(), state, key)); }

    const bBlock = document.createElement('div'); bBlock.className = 'track-block boundary-block';
    const bDone = !!state['boundary'];
    bBlock.innerHTML = `<div class="track-head"><span class="name"><h2>The Boundary</h2></span></div>`;
    const bRow = document.createElement('div'); bRow.className = 'item' + (bDone?' done':'');
    bRow.innerHTML = `<div class="box"></div><span>Screens down before bed — a curfew, not a task</span>`;
    bRow.addEventListener('click', async ()=>{
      state['boundary'] = !state['boundary']; cache[key]=state; await saveDay(key); renderAll();
    });
    bBlock.appendChild(bRow);
    box.appendChild(bBlock);

    const ratio = dayRatio(state, dow);
  }

  function renderReadCard(){
    const read = todaysRead(selected);
    document.getElementById('readCard').href = read.u;
    document.getElementById('readTitle').textContent = read.t;
    document.getElementById('readSource').textContent = read.s;
    document.getElementById('readImg').src = read.img || ("data:image/jpeg;base64," + FALLBACK_IMG);
  }

  async function renderDigest(){
    const data = await loadDigest();
    document.querySelectorAll('#digestBox textarea').forEach(ta=>{
      const f = ta.getAttribute('data-field');
      ta.value = data[f] || '';
      ta.oninput = ()=>{
        digestCache[f] = ta.value;
        clearTimeout(ta._t);
        ta._t = setTimeout(async ()=>{
          await saveDigest();
          const note = document.getElementById('digestSaved');
          note.textContent = 'saved';
          setTimeout(()=>{ note.textContent=''; }, 1400);
        }, 500);
      };
    });
  }

  function renderElsewhere(){
    const row = document.getElementById('elsewhereRow'); row.innerHTML='';

    const mcqLink = document.createElement('a');
    mcqLink.className = 'elsewhere-item'; mcqLink.href = 'sqe1-phase1-companion.html'; mcqLink.target = '_blank'; mcqLink.rel = 'noopener';
    mcqLink.innerHTML = `<div class="glyph">✓</div><div class="exbody"><div class="extag">MCQ Practice</div><div class="exname">SQE1 Phase 1 Companion</div><div class="exsub">keep this file alongside the tracker</div></div>`;
    row.appendChild(mcqLink);
  }

  async function renderAll(){
    await renderWeekStrip();
    renderCheckpoint();
    await renderEntries();
    renderElsewhere();
    renderReadCard();
    document.getElementById('streakNum').textContent = await computeStreak();
  }

  renderAll();
  renderDigest();
})();
</script>
